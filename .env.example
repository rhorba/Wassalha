# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon: https://neon.tech, or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/wassalha

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (keep as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Clerk webhook secret — get from Clerk dashboard → Webhooks → your endpoint
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Google Maps ──────────────────────────────────────────────────────────────
# Needed in Phase 2 — add now to avoid missing key errors later
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ─── Supabase Realtime (Phase 5) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Vercel Cron (Phase 5) ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-min-32-chars

# ─── Mapbox (Phase 5) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ─── Stripe (Phase 6 — commission billing) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from: Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend Email (Phase 4) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Use onboarding@resend.dev for testing (no domain verification needed)
# Switch to your verified domain in production: noreply@wassalha.ma
RESEND_FROM_EMAIL=Wassalha <onboarding@resend.dev>

# ─── Carrier APIs (Phase 4) ───────────────────────────────────────────────────

# Amana Maroc
AMANA_API_URL=https://api.amana.ma
AMANA_API_KEY=
AMANA_ACCOUNT_ID=

# Aramex (SOAP endpoints hardcoded in adapter — no API URL needed)
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=CAS
ARAMEX_ACCOUNT_COUNTRY_CODE=MA

# CTM Messagerie
CTM_API_URL=https://api.ctm.ma
CTM_API_KEY=

# Marocolis (Poste Maroc)
MAROCOLIS_API_URL=https://api.marocolis.ma
MAROCOLIS_CLIENT_ID=
MAROCOLIS_CLIENT_SECRET=

# Sendex
SENDEX_API_URL=https://api.sendex.ma
SENDEX_API_TOKEN=

# ─── WhatsApp Business API (Phase 4) ──────────────────────────────────────────
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_ID=...
WHATSAPP_TEMPLATE_NAME=shipment_notification

# ─── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ─── Sentry (Phase 8) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=wassalha

# ─── Upstash Redis (Phase 8 — rate limiting) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Web Push / VAPID (W9 — push notifications) ──────────────────────────────
# Generate keys once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wassalha.ma
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # same value as VAPID_PUBLIC_KEY

# ─── E2E test users (Phase 8 — Playwright) ────────────────────────────────────
# Create two Clerk test users with +clerk_test email suffix (e.g. retailer+clerk_test@example.com)
# Retailer: no publicMetadata.role  |  Admin: publicMetadata: {"role":"admin"}
E2E_RETAILER_EMAIL=retailer+clerk_test@example.com
E2E_RETAILER_PASSWORD=your-retailer-test-password
E2E_ADMIN_EMAIL=admin+clerk_test@example.com
E2E_ADMIN_PASSWORD=your-admin-test-password
