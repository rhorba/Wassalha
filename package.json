    "clsx": "^2.1.1",
    "drizzle-orm": "^0.40.1",
    "lucide-react": "^0.577.0",
    "next": "^15.2.3",
    "pg": "^8.13.3",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
